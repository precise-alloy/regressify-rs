{
  "routes": [
    {
      "route": "/_snapshot/status.json",
      "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/_snapshot/deployment.json",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.{woff,woff2,ttf,otf,svg,css,js,ico,png,jpg,jpeg,webp,gif,xsl,json}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000"
      }
    }
  ],
  "mimeTypes": {
    ".html": "text/html; charset=utf-8",
    ".js": "text/javascript; charset=utf-8",
    ".css": "text/css; charset=utf-8",
    ".map": "text/plain; charset=utf-8",
    ".json": "application/json; charset=utf-8",
    ".ps1": "text/plain; charset=utf-8",
    ".sh": "text/plain; charset=utf-8",
    ".xml": "application/xml; charset=utf-8",
    ".xsl": "application/xml; charset=utf-8",
    ".woff2": "font/woff2"
  },
  "globalHeaders": {
    "Access-Control-Max-Age": "86400",
    "Cross-Origin-Opener-Policy": "same-origin",
    "Referrer-Policy": "no-referrer",
    "Vary": "Origin",
    "X-Content-Type-Options": "nosniff",
    "X-Robots-Tag": "noindex,nofollow,nocache,nosnippet,noarchive"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/_snapshot/*"]
  }
}
