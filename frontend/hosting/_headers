/*
  Access-Control-Max-Age: 86400
  Cross-Origin-Opener-Policy: same-origin
  Referrer-Policy: no-referrer
  Vary: Origin
  X-Content-Type-Options: nosniff
  X-Robots-Tag: noindex,nofollow,nocache,nosnippet,noarchive

/*.woff
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.woff2
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.ttf
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.otf
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.svg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.css
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000
  Content-Type: text/css; charset=utf-8

/*.js
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000
  Content-Type: text/javascript; charset=utf-8

/*.ico
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.png
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.jpg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.jpeg
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.webp
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.gif
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/*.xsl
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000
  Content-Type: application/xml; charset=utf-8

/*.html
  Content-Type: text/html; charset=utf-8

/*.map
  Content-Type: text/plain; charset=utf-8

/*.json
  Content-Type: application/json; charset=utf-8

/_snapshot/data/*
  Cache-Control: public, max-age=31536000, s-maxage=31536000, immutable, stale-while-revalidate=31536000

/_snapshot/status.json
  Access-Control-Allow-Origin: *
  Cache-Control: no-cache

/_snapshot/deployment.json
  Cache-Control: no-cache

/*.ps1
  Content-Type: text/plain; charset=utf-8

/*.sh
  Content-Type: text/plain; charset=utf-8

/*.xml
  Content-Type: application/xml; charset=utf-8