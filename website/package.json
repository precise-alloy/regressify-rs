{
  "name": "regressify-website",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check && bun run test",
    "test": "bun test ./src",
    "worker:check": "node mcp/node_modules/typescript/bin/tsc --project tsconfig.worker.json",
    "worker:build": "mcp/node_modules/.bin/wrangler deploy --dry-run --config wrangler.jsonc",
    "worker:dev": "mcp/node_modules/.bin/wrangler dev --config wrangler.jsonc --env-file ../.env.local",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "0.42.7",
    "@tailwindcss/vite": "4.3.5",
    "astro": "^7.4.2",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/bun": "~1.4.2",
    "typescript": "^6.0.3"
  }
}