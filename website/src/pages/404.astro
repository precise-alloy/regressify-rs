---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
---

<BaseLayout title="Page not found" description="The page you are looking for does not exist." noindex>
  <div class="page-container grid justify-items-center gap-md py-[96px] text-center">
    <p class="eyebrow">404</p>
    <h1 class="text-3xl leading-[1.2]">Page not found</h1>
    <p class="muted">The page may have moved, or the link may be mistyped.</p>
    <div class="mt-sm flex flex-wrap justify-center gap-sm">
      <Button variant="primary" href="/">Go home</Button>
      <Button href="/docs/">Read the docs</Button>
    </div>
  </div>
</BaseLayout>
