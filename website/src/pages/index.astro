---
import { Image } from 'astro:assets';
import overview from '../assets/docs/desktop/overview.png';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import DownloadButton from '../components/DownloadButton.astro';
import Icon from '../components/Icon.astro';
import ReleaseMeta from '../components/ReleaseMeta.astro';

const inlineLink = 'inline-flex items-center gap-sm text-(length:--text-sm) no-underline';
const highlight = 'flex items-center gap-[10px] text-(length:--text-sm)';
const scriptLink = 'mt-[10px] inline-block text-(length:--text-xs) text-muted-foreground';
---

<BaseLayout>
  <section class="pt-[64px] pb-[40px] max-[480px]:pt-[36px] max-[480px]:pb-[28px]">
    <div class="page-container flex flex-col items-start gap-[18px]">
      <p class="eyebrow">Visual regression testing</p>
      <h1 class="text-[3.5rem] leading-[1.05] tracking-[0] max-[480px]:text-[2.5rem]">Regressify</h1>
      <p class="max-w-[48ch] text-lg text-muted-foreground">
        Catch visual changes before your users do.<br class="max-[480px]:hidden" />
        From your desktop or your CI pipeline.
      </p>
      <div class="mt-[6px] grid w-full gap-md">
        <div class="flex flex-wrap items-center gap-md max-[480px]:flex-col max-[480px]:items-stretch">
          <DownloadButton />
          <Button size="lg" variant="ghost" href="/docs/getting-started/">
            Get started
            <Icon name="arrow-right" />
          </Button>
        </div>
        <ReleaseMeta />
      </div>
    </div>
  </section>

  <section aria-label="Regressify Desktop">
    <div class="page-container">
      <a class="block" href="/docs/desktop-app/" aria-label="Explore Regressify Desktop">
        <Image
          src={overview}
          alt="Regressify Desktop workspace listing test suites with capture, run, and review actions."
          widths={[640, 960, 1600]}
          sizes="(max-width: 1080px) 100vw, 1016px"
          format="webp"
          loading="eager"
          fetchpriority="high"
          class="h-auto w-full rounded-md border border-border"
        />
      </a>
      <div class="flex flex-wrap items-center justify-between gap-md pt-[14px] pb-[28px] text-(length:--text-sm) text-muted-foreground">
        <span>Capture. Compare. Approve.</span>
        <a href="/docs/desktop-app/" class={inlineLink}>Explore the desktop app <Icon name="arrow-right" size={14} /></a>
      </div>
      <ul class="m-0 flex list-none flex-wrap gap-x-[40px] gap-y-[18px] border-y border-y-border px-0 py-xl max-[480px]:gap-x-xl max-[480px]:gap-y-lg" aria-label="At a glance">
        <li class={highlight}><Icon name="layout-dashboard" size={18} /> Desktop &amp; CLI</li>
        <li class={highlight}><Icon name="globe" size={18} /> Managed Chromium</li>
        <li class={highlight}><Icon name="file-text" size={18} /> YAML &amp; JSON suites</li>
      </ul>
    </div>
  </section>

  <section class="pt-[48px] pb-lg" aria-labelledby="terminal-install">
    <div class="page-container">
      <div class="flex flex-wrap items-center justify-between gap-md">
        <h2 id="terminal-install" class="text-xl leading-[1.3]">Install from your terminal</h2>
        <a href="/download/" class={inlineLink}>All downloads <Icon name="arrow-right" size={14} /></a>
      </div>
      <div class="mt-xl grid gap-xl min-[900px]:grid-cols-2">
        <div class="min-w-0">
          <CodeBlock wrap title="Windows · PowerShell" lang="powershell" code="irm https://regressify.eshn.dev/install.ps1 | iex" />
          <a class={scriptLink} href="/install.ps1">Review PowerShell script</a>
        </div>
        <div class="min-w-0">
          <CodeBlock wrap title="macOS & Linux" lang="sh" code="curl -fsSL https://regressify.eshn.dev/install.sh | sh" />
          <a class={scriptLink} href="/install.sh">Review shell script</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
