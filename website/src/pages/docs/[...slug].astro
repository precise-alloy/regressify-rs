---
import { render } from 'astro:content';
import DocsLayout from '../../layouts/DocsLayout.astro';
import { formatDate, getDocs } from '../../lib/content';

export async function getStaticPaths() {
  const docs = await getDocs();
  return docs.map((doc) => ({ params: { slug: doc.id }, props: { doc } }));
}

const { doc } = Astro.props;
const { Content, headings } = await render(doc);
---

<DocsLayout title={doc.data.title} description={doc.data.description} currentId={doc.id} headings={headings}>
  <div class="prose">
    <h1>{doc.data.title}</h1>
    <p class="lead">{doc.data.description}</p>
    <Content />
    {
      doc.data.updated && (
        <p class="updated">
          Last updated <time datetime={doc.data.updated.toISOString()}>{formatDate(doc.data.updated)}</time>
        </p>
      )
    }
  </div>
</DocsLayout>

<style>
  h1 {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  .lead {
    color: var(--muted-foreground);
    font-size: var(--text-lg);
    line-height: var(--leading-lg);
  }

  .updated {
    margin-top: var(--space-xxl);
    color: var(--muted-foreground);
    font-size: var(--text-sm);
  }
</style>
