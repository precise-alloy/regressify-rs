---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteColumns } from '../../lib/admin-table';
---

<BaseLayout title="Admin" description="Regressify site deployments" noindex>
  <section class="container admin" data-admin aria-labelledby="admin-title">
    <div class="title-row">
      <div><p class="eyebrow">Administration</p><h1 id="admin-title">Site deployments</h1></div>
      <span id="site-count" class="muted">0 sites</span>
    </div>
    <div class="toolbar">
      <label class="search"><span class="visually-hidden">Search site URLs</span><input id="site-search" type="search" placeholder="Search site URLs" autocomplete="off" /></label>
      <label class="automatic"><input id="auto-refresh" type="checkbox" checked /> Auto-refresh (60s)</label>
      <button id="refresh-sites" class="refresh" type="button" title="Refresh sites" aria-label="Refresh sites"><Icon name="refresh-cw" size={18} /></button>
    </div>
    <div class="feed-meta"><p id="feed-status" role="status">Loading sites...</p></div>
    <p id="partial-sites" class="warning" hidden>The query returned a partial result. More sites are available in PostHog.</p>
    <div class="table-scroll" role="region" aria-label="Site deployments" tabindex="0">
      <table aria-label="Site deployments">
        <thead><tr><th scope="col" class="row-index" aria-label="Row number">#</th>{siteColumns.map(([key, label]) => <th scope="col" data-column={key} class={key === 'url' ? 'site-column' : undefined} aria-sort={key === 'datetime' ? 'descending' : 'none'}><button type="button" data-sort={key}>{label}<Icon name="arrow-up-down" size={14} /></button></th>)}<th scope="col" class="details-column"><span class="visually-hidden">Details</span></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p id="empty-sites" class="empty" hidden></p>
    <template id="site-details-button">
      <button class="icon-button" type="button" title="Deployment details" aria-haspopup="dialog" aria-controls="site-details"><Icon name="info" size={18} /></button>
    </template>
    <dialog id="site-details" class="site-details" aria-labelledby="site-details-title">
      <div class="details-heading">
        <h2 id="site-details-title">Deployment details</h2>
        <button id="close-site-details" class="icon-button" type="button" title="Close details" aria-label="Close details" autofocus><Icon name="x" size={20} /></button>
      </div>
      <dl id="site-detail-fields" class="detail-fields"></dl>
    </dialog>
    <noscript><p class="empty">JavaScript is required to load site deployments.</p></noscript>
  </section>
</BaseLayout>

<script>
  import { mountAdmin } from '../../lib/admin-table';
  mountAdmin();
</script>

<style is:global>
  .admin { padding-block: 40px 64px; }
  .admin h1 { font-size: var(--text-2xl); line-height: 1.3; margin-top: 8px; }
  .admin .title-row { display: flex; align-items: end; justify-content: space-between; gap: 16px; margin-bottom: 24px; }
  .admin .toolbar { display: flex; align-items: center; gap: 16px; padding-block: 16px; border-block: 1px solid var(--border); }
  .admin .search { flex: 1; min-width: 0; }
  .admin input[type='search'] { width: 100%; max-width: 420px; height: 40px; padding: 8px 12px; border: 1px solid var(--input); border-radius: var(--radius-md); background: var(--background); color: var(--foreground); font: inherit; font-size: var(--text-sm); }
  .admin .automatic { display: flex; align-items: center; gap: 8px; font-size: var(--text-sm); white-space: nowrap; }
  .admin input[type='checkbox'] { accent-color: var(--primary); width: 16px; height: 16px; }
  .admin .refresh { display: grid; place-items: center; width: 40px; height: 40px; flex: 0 0 40px; border: 1px solid var(--button-border); border-radius: var(--radius-md); background: var(--button); color: var(--button-foreground); cursor: pointer; }
  .admin .refresh:hover { background: var(--button-hover); }
  .admin .refresh:disabled { cursor: wait; opacity: 0.5; }
  .admin .feed-meta { padding-block: 12px; min-height: 44px; color: var(--muted-foreground); font-size: var(--text-sm); }
  .admin [data-error='true'], .admin .warning { color: var(--danger); }
  .admin .warning { margin-bottom: 12px; font-size: var(--text-sm); }
  .admin .table-scroll { overflow-x: auto; border-bottom: 1px solid var(--border); }
  .admin table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: var(--text-sm); }
  .admin th, .admin td { padding: 12px; border-top: 1px solid var(--border); vertical-align: middle; }
  .admin th { background: var(--muted); font-weight: var(--weight-medium); width: 15%; text-align: right; }
  .admin th.site-column { width: auto; text-align: left; }
  .admin th.row-index { width: 3.5rem; }
  .admin .details-column { width: 3.5rem; padding: 4px; text-align: center; }
  .admin .row-index { color: var(--muted-foreground); }
  .admin th button { display: inline-flex; align-items: center; justify-content: flex-end; gap: 6px; width: 100%; padding: 0; background: none; border: 0; color: var(--muted-foreground); font: inherit; cursor: pointer; }
  .admin th.site-column button { justify-content: flex-start; }
  .admin th[aria-sort='ascending'] button, .admin th[aria-sort='descending'] button { color: var(--foreground); }
  .admin td { overflow-wrap: anywhere; }
  .admin .metric { text-align: right; font-family: var(--font-mono); font-variant-numeric: tabular-nums; }
  .admin strong { color: inherit; }
  .admin tbody tr:hover { background: var(--list-hover); }
  .admin td a { text-decoration: none; }
  .admin td[data-column='url'] a { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .admin td a:hover { text-decoration: underline; }
  .admin .empty { padding-block: 32px; color: var(--muted-foreground); text-align: center; }
  .admin .icon-button { display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0; flex: 0 0 44px; border: 0; border-radius: var(--radius-md); background: transparent; color: var(--muted-foreground); cursor: pointer; }
  .admin .icon-button:hover { background: var(--list-hover); color: var(--foreground); }
  .admin button:focus-visible, .admin a:focus-visible { outline: 2px solid var(--primary); outline-offset: 2px; }
  .admin .site-details { box-sizing: border-box; width: min(36rem, calc(100% - 32px)); max-width: none; max-height: calc(100dvh - 32px); margin: auto; padding: 24px; overflow-y: auto; border: 1px solid var(--border); border-radius: 8px; background: var(--background); color: var(--foreground); box-shadow: 0 12px 48px rgb(0 0 0 / 0.18); }
  .admin .site-details::backdrop { background: rgb(0 0 0 / 0.4); }
  .admin .details-heading { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
  .admin .details-heading h2 { margin: 0; font-size: var(--text-lg); line-height: 1.4; }
  .admin .detail-fields { display: grid; grid-template-columns: minmax(0, 7rem) minmax(0, 1fr); gap: 16px; margin: 0; font-size: var(--text-sm); }
  .admin .detail-fields dt { color: var(--muted-foreground); overflow-wrap: anywhere; }
  .admin .detail-fields dd { min-width: 0; margin: 0; overflow-wrap: anywhere; font-variant-numeric: tabular-nums; }
  .admin .detail-json { white-space: pre-wrap; font-family: var(--font-mono); }
  .admin:has(.site-details[open]) { overscroll-behavior: contain; }
  body:has(.site-details[open]) { overflow: hidden; }
  @media (max-width: 767px) {
    html:has(.site-details[open]) { scrollbar-gutter: auto; }
    .admin .row-index { display: none; }
    .admin [data-column='file_count'], .admin [data-column='total_bytes'], .admin [data-column='duration_ms'] { display: none; }
    .admin th[data-column='datetime'] { width: 6rem; }
    .admin th, .admin td { padding: 12px 8px; }
    .admin .details-column { padding: 4px; }
    .admin { padding-top: 24px; }
    .admin .toolbar { flex-wrap: wrap; gap: 12px; }
    .admin .search { flex-basis: 100%; }
    .admin input[type='search'] { max-width: none; }
    .admin .refresh { margin-left: auto; }
    .admin .title-row { align-items: start; flex-wrap: wrap; }
    .admin #site-count { white-space: nowrap; font-size: var(--text-sm); }
    .admin .site-details { width: 100vw; max-height: calc(100dvh - 24px); margin: auto 0 0; padding: 20px 16px max(20px, env(safe-area-inset-bottom)); border-bottom: 0; border-radius: 8px 8px 0 0; }
    .admin .detail-fields { grid-template-columns: minmax(0, 5.5rem) minmax(0, 1fr); gap: 16px 12px; }
  }
</style>