---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { siteColumns, type SiteColumn } from '../../lib/admin-table';

// Matches adminClasses in admin-table.ts, which styles the rows built in script.
const focusRing = 'focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary';
const headBase = 'border-t border-t-border bg-muted align-middle font-medium';
const headCell = `${headBase} p-md max-[768px]:px-sm`;
const headClass = (key: SiteColumn) =>
  key === 'url'
    ? `group/sort ${headCell} w-auto text-left`
    : key === 'datetime'
      ? `group/sort ${headCell} w-[15%] text-right max-[768px]:w-[6rem]`
      : `group/sort ${headCell} w-[15%] text-right max-[768px]:hidden`;
const sortButton = (key: SiteColumn) =>
  `inline-flex w-full cursor-pointer items-center gap-[6px] [border:0] bg-transparent p-0 font-inherit [font-size:inherit] [font-weight:inherit] [line-height:inherit] text-muted-foreground group-aria-[sort=ascending]/sort:text-foreground group-aria-[sort=descending]/sort:text-foreground ${focusRing} ${key === 'url' ? 'justify-start' : 'justify-end'}`;
const iconButton = `inline-grid size-[44px] flex-[0_0_44px] cursor-pointer place-items-center rounded-md [border:0] bg-transparent p-0 text-muted-foreground hover:bg-list-hover hover:text-foreground ${focusRing}`;
const empty = 'py-xxl text-center text-muted-foreground';
---

<BaseLayout title="Admin" description="Regressify site deployments" noindex>
  <section
    class="page-container pt-[40px] pb-[64px] has-[dialog[open]]:overscroll-contain max-[768px]:pt-xl"
    data-admin
    aria-labelledby="admin-title">
    <div class="mb-xl flex justify-between gap-lg [align-items:end] max-[768px]:flex-wrap max-[768px]:[align-items:start]">
      <div><p class="eyebrow">Administration</p><h1 id="admin-title" class="mt-sm text-2xl leading-[1.3]">Site deployments</h1></div>
      <span id="site-count" class="muted max-[768px]:text-(length:--text-sm) max-[768px]:whitespace-nowrap">0 sites</span>
    </div>
    <div class="flex items-center gap-lg border-y border-y-border py-lg max-[768px]:flex-wrap max-[768px]:gap-md">
      <label class="min-w-0 flex-1 max-[768px]:basis-full"><span class="visually-hidden">Search site URLs</span><input id="site-search" class="h-[40px] w-full max-w-[420px] rounded-md border border-input bg-background px-md py-sm font-inherit [font-weight:inherit] [line-height:inherit] text-(length:--text-sm) text-foreground max-[768px]:max-w-none" type="search" placeholder="Search site URLs" autocomplete="off" /></label>
      <label class="flex items-center gap-sm text-(length:--text-sm) whitespace-nowrap"><input id="auto-refresh" class="size-[16px] accent-primary" type="checkbox" checked /> Auto-refresh (60s)</label>
      <button id="refresh-sites" class={`grid size-[40px] flex-[0_0_40px] cursor-pointer place-items-center rounded-md border border-button-border bg-button text-button-foreground hover:bg-button-hover disabled:cursor-wait disabled:opacity-50 max-[768px]:ml-auto ${focusRing}`} type="button" title="Refresh sites" aria-label="Refresh sites"><Icon name="refresh-cw" size={18} /></button>
    </div>
    <div class="min-h-[44px] py-md text-(length:--text-sm) text-muted-foreground"><p id="feed-status" class="data-[error=true]:text-danger" role="status">Loading sites...</p></div>
    <p id="partial-sites" class="mb-md text-(length:--text-sm) text-danger" hidden>The query returned a partial result. More sites are available in PostHog.</p>
    <div class="overflow-x-auto border-b border-b-border" role="region" aria-label="Site deployments" tabindex="0">
      <table class="w-full table-fixed border-collapse text-(length:--text-sm)" aria-label="Site deployments">
        <thead><tr><th scope="col" class={`${headCell} w-[3.5rem] text-right text-muted-foreground max-[768px]:hidden`} aria-label="Row number">#</th>{siteColumns.map(([key, label]) => <th scope="col" data-column={key} class={headClass(key)} aria-sort={key === 'datetime' ? 'descending' : 'none'}><button type="button" class={sortButton(key)} data-sort={key}>{label}<Icon name="arrow-up-down" size={14} /></button></th>)}<th scope="col" class={`${headBase} w-[3.5rem] p-xs text-center`}><span class="visually-hidden">Details</span></th></tr></thead>
        <tbody></tbody>
      </table>
    </div>
    <p id="empty-sites" class={empty} hidden></p>
    <template id="site-details-button">
      <button class={iconButton} type="button" title="Deployment details" aria-haspopup="dialog" aria-controls="site-details"><Icon name="info" size={18} /></button>
    </template>
    {/* On phones the details open as a bottom sheet. */}
    <dialog
      id="site-details"
      class="m-auto box-border max-h-[calc(100dvh-32px)] w-[min(36rem,calc(100%-32px))] max-w-none overflow-y-auto rounded-lg border border-border bg-background p-xl text-foreground [box-shadow:0_12px_48px_rgb(0_0_0/0.18)] backdrop:bg-[rgb(0_0_0/0.4)] max-[768px]:mx-0 max-[768px]:mb-0 max-[768px]:max-h-[calc(100dvh-24px)] max-[768px]:w-screen max-[768px]:rounded-b-none max-[768px]:[border-bottom:0] max-[768px]:px-lg max-[768px]:pt-[20px] max-[768px]:pb-[max(20px,env(safe-area-inset-bottom))]"
      aria-labelledby="site-details-title">
      <div class="mb-[20px] flex items-center justify-between gap-md">
        <h2 id="site-details-title" class="m-0 text-lg leading-[1.4]">Deployment details</h2>
        <button id="close-site-details" class={iconButton} type="button" title="Close details" aria-label="Close details" autofocus><Icon name="x" size={20} /></button>
      </div>
      <dl id="site-detail-fields" class="m-0 grid grid-cols-[minmax(0,7rem)_minmax(0,1fr)] gap-lg text-(length:--text-sm) max-[768px]:grid-cols-[minmax(0,5.5rem)_minmax(0,1fr)] max-[768px]:gap-x-md"></dl>
    </dialog>
    <noscript><p class={empty}>JavaScript is required to load site deployments.</p></noscript>
  </section>
</BaseLayout>

<script>
  import { mountAdmin } from '../../lib/admin-table';
  mountAdmin();
</script>
