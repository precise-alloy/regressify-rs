---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="News and release notes from the Regressify project.">
  <div class="container blog">
    <header class="heading">
      <div>
        <h1>Blog</h1>
        <p class="muted">News and release notes from the Regressify project.</p>
      </div>
      <a href="/rss.xml" class="rss"><Icon name="rss" /> RSS</a>
    </header>
    <ul class="posts">
      {
        posts.map((post) => (
          <li>
            <article>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <h2>
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h2>
              <p class="muted">{post.data.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
  </div>
</BaseLayout>

<style>
  .blog {
    max-width: calc(72ch + 2 * var(--space-xl));
    padding-block: var(--space-xxl);
  }

  .heading {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-lg);
    padding-bottom: var(--space-lg);
    border-bottom: var(--border-width) solid var(--border);
  }

  h1 {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  .rss {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-sm);
  }

  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posts li {
    padding-block: var(--space-xl);
    border-bottom: var(--border-width) solid var(--border);
  }

  article {
    display: grid;
    gap: var(--space-xs);
  }

  time {
    color: var(--muted-foreground);
    font-size: var(--text-xs);
  }

  h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
  }
</style>
