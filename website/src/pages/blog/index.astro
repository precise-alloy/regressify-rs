---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import { formatDate, getPosts } from '../../lib/content';

const posts = await getPosts();
---

<BaseLayout title="Blog" description="News and release notes from the Regressify project.">
  <div class="page-container max-w-[calc(72ch+2*var(--space-xl))] py-xxl">
    <header class="flex flex-wrap items-end justify-between gap-lg border-b border-b-border pb-lg">
      <div>
        <h1 class="text-3xl leading-[1.2]">Blog</h1>
        <p class="muted">News and release notes from the Regressify project.</p>
      </div>
      <a href="/rss.xml" class="inline-flex items-center gap-xs text-(length:--text-sm)"><Icon name="rss" /> RSS</a>
    </header>
    <ul class="m-0 list-none p-0">
      {
        posts.map((post) => (
          <li class="border-b border-b-border py-xl">
            <article class="grid gap-xs">
              <time datetime={post.data.date.toISOString()} class="text-(length:--text-xs) text-muted-foreground">{formatDate(post.data.date)}</time>
              <h2 class="text-xl">
                <a href={`/blog/${post.id}/`} class="no-underline hover:underline">{post.data.title}</a>
              </h2>
              <p class="muted">{post.data.description}</p>
            </article>
          </li>
        ))
      }
    </ul>
    {posts.length === 0 && <p class="muted">No posts yet.</p>}
  </div>
</BaseLayout>
