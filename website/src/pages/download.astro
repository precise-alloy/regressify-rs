---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { downloadHref, formatSize, getRelease, getReleaseArchives } from '../lib/release';

// Facts on this page come from docs/desktop.md (Windows Installation and Updates,
// Build and Launch) and README.md. Only Windows x64 has an installer; release
// deployments also publish CLI and desktop archives for every built platform.
const release = await getRelease();
const latestHref = downloadHref(release);
const archives = await getReleaseArchives();
const platforms = [
  { id: 'windows-archives', title: 'Windows archives', items: archives.filter((archive) => archive.target.endsWith('-msvc')) },
  { id: 'macos', title: 'macOS', items: archives.filter((archive) => archive.target.endsWith('-darwin')) },
  { id: 'linux', title: 'Linux', items: archives.filter((archive) => archive.target.includes('-linux-')) },
];
const repoUrl = SITE.repoUrl;
const cloneUrl = repoUrl ? `${repoUrl}.git` : null;

const verify = release.status === 'available' ? `Get-FileHash .\\${release.fileName} -Algorithm SHA256` : '';
const windowsCliInstall = 'irm https://regressify.eshn.dev/install.ps1 | iex';
const unixCliInstall = 'curl -fsSL https://regressify.eshn.dev/install.sh | sh';

const fromSource = [
  cloneUrl ? `git clone ${cloneUrl}\ncd regressify-rs` : '# From a checkout of the Regressify repository',
  '',
  '# Install the CLI into your Cargo bin directory',
  'cargo install --path .',
  '',
  '# Optional: download the managed Chromium build ahead of offline runs',
  'regressify install',
].join('\n');

const desktopFromSource = `cargo build --release --features gui --bin regressify-desktop`;
---

<BaseLayout title="Download" description="Download the Regressify desktop app and CLI for Windows, macOS, and Linux, or build them from source.">
  <div class="container page">
    <header class="heading">
      <h1>Download Regressify</h1>
      <p class="muted">Install the desktop app and CLI from the terminal or direct downloads on Windows, macOS, and Linux.</p>
      <nav class="links" aria-label="Download platforms">
        <a href="#windows">Windows</a><a href="#macos">macOS</a><a href="#linux">Linux</a>
      </nav>
    </header>

    <section class="option" aria-labelledby="cli-install-heading">
      <div class="option-head">
        <span class="badge">Windows, macOS, Linux</span>
        <h2 id="cli-install-heading">Install from the command line</h2>
      </div>
      <p class="muted">
        Downloads are checked against the release SHA-256. These commands execute a script from this site;
        review the <a href="/install.ps1">PowerShell script</a> or <a href="/install.sh">shell script</a> first.
      </p>
      <CodeBlock title="Windows (PowerShell)" code={windowsCliInstall} lang="powershell" />
      <CodeBlock title="macOS and Linux" code={unixCliInstall} lang="sh" />
      <p class="muted small">
        On Windows, the verified setup downloads its matching application files. On macOS and Linux,
        the command installs <code>regressify</code> and{' '}
        <code>regressify-desktop</code> (where supported) into <code>~/.local/bin</code> and prepares the managed Chromium
        build.
      </p>
      <p class="muted small">Terminal downloads may not receive browser-added origin metadata. Unsigned applications can still trigger operating-system or organization security warnings.</p>
    </section>

    <section id="windows" class="option">
      <div class="option-head">
        <span class="badge">Windows x64</span>
        <h2>Desktop app and CLI installer</h2>
      </div>
      <ul class="facts">
        <li>Per-user setup in <code>%LOCALAPPDATA%\Programs\Regressify</code> with no administrator rights.</li>
        <li>Installs Regressify Desktop and the <code>regressify</code> CLI and adds them to your user PATH.</li>
        <li>Prepares the managed Chromium build used for captures.</li>
        <li>Checks for updates in the background and verifies each download by SHA-256 before notifying you.</li>
      </ul>

      {
        release.status === 'available' ? (
          <div class="release">
            <Button variant="primary" size="lg" href={latestHref ?? release.url} rel="noopener">
              <Icon name="download" />
              Download for Windows
            </Button>
            {/* Release deployments rebuild this page, so details match the published file. */}
            <dl class="details">
              <div>
                <dt>Version</dt>
                <dd>{release.version}</dd>
              </div>
              <div>
                <dt>File</dt>
                <dd>
                  <code>{release.fileName}</code>
                </dd>
              </div>
              <div>
                <dt>Size</dt>
                <dd>{formatSize(release.size)}</dd>
              </div>
              <div>
                <dt>SHA-256</dt>
                <dd>
                  <code class="hash">{release.sha256}</code>
                </dd>
              </div>
            </dl>
            <p class="muted small">
              Verify the downloaded{' '}
              <a href={release.url} rel="noopener">
                {release.fileName}
              </a>{' '}
              in PowerShell:
            </p>
            <CodeBlock code={verify} lang="powershell" />
          </div>
        ) : release.status === 'unpublished' ? (
          <div class="notice" role="status">
            <p>
              <strong>The Windows installer is not published yet.</strong> Build from source below in the meantime; this page
              updates with the next site build after a release.
            </p>
          </div>
        ) : (
          // A failed or invalid feed check says nothing about whether a release
          // exists, so do not claim it is unpublished.
          <div class="notice" role="status">
            <p>
              <strong>Installer details could not be verified when this page was built.</strong> Try again later, or{' '}
              <a href="#source-heading">build from source</a> below.
            </p>
          </div>
        )
      }
      <p class="muted small">
        Installers are currently unsigned, so Windows may show a SmartScreen warning. Open a new terminal after setup to
        use <code>regressify</code>.
      </p>
    </section>

    {platforms.map(({ id, title, items }) => (
        <section id={id} class="option" aria-labelledby={`${id}-heading`}>
          <h2 id={`${id}-heading`}>{title}</h2>
          {id === 'linux' && <p class="muted small">CLI and desktop: x64 glibc systems. The desktop app also requires compatible GUI libraries. Musl and Linux ARM64 releases are not available.</p>}
          {id === 'macos' && <p class="muted small">Choose Apple silicon or Intel to match your Mac. The terminal command selects the architecture automatically.</p>}
          {items.length > 0 ? (
                <div class="table-wrap">
                  <table>
                    <caption class="visually-hidden">{title} release assets</caption>
                    <thead>
                      <tr>
                        <th scope="col">Platform</th>
                        <th scope="col">Application</th>
                        <th scope="col">File</th>
                        <th scope="col">Size</th>
                        <th scope="col">SHA-256</th>
                      </tr>
                    </thead>
                    <tbody>
                      {items.map((archive) => (
                        <tr>
                          <td>{archive.platform}</td>
                          <td>{archive.application === 'cli' ? 'CLI' : 'Desktop'}</td>
                          <td>
                            <a href={archive.url} title={archive.fileName}>{archive.format.toUpperCase()}</a>
                          </td>
                          <td>{formatSize(archive.size)}</td>
                          <td>
                            <a class="checksum" href={`${archive.url}.sha256`} title={archive.sha256}>
                              {archive.sha256.slice(0, 12)}…
                            </a>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
                ) : <p class="muted">Release files are unavailable. Use the source build below.</p>}
          <p class="muted small">
            Binaries are unsigned; macOS may require allowing them in System Settings &gt; Privacy &amp; Security.
          </p>
        </section>
    ))}

    <section class="option" aria-labelledby="source-heading">
      <div class="option-head">
        <span class="badge">Windows, macOS, Linux</span>
        <h2 id="source-heading">Build from source</h2>
      </div>
      <p class="muted">
        Requires the stable Rust toolchain. Regressify supports Chromium only; it downloads and caches its own pinned
        build, so no Node or Playwright install is needed.
      </p>
      <CodeBlock title="CLI" code={fromSource} lang="sh" />
      <p class="muted small">
        The desktop app builds from the same checkout. On Windows it also needs the Visual Studio C++ build tools and the
        Windows SDK.
      </p>
      <CodeBlock title="Desktop app" code={desktopFromSource} lang="sh" />
      <div class="links">
        <Button href="/docs/getting-started/">
          Getting started guide
          <Icon name="arrow-right" />
        </Button>
        {
          repoUrl && (
            <Button variant="ghost" href={repoUrl}>
              <Icon name="github" />
              Source on GitHub
            </Button>
          )
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-xl);
    max-width: 880px;
    padding-block: var(--space-xxl);
  }

  .heading {
    display: grid;
    gap: var(--space-sm);
  }

  h1 {
    font-size: var(--text-3xl);
    line-height: 1.2;
  }

  :global(.option) {
    display: grid;
    gap: var(--space-lg);
    min-width: 0;
    padding-block: var(--space-lg);
    border-top: var(--border-width) solid var(--border);
    scroll-margin-top: 80px;
  }

  .option-head {
    display: grid;
    gap: var(--space-sm);
    justify-items: start;
  }

  h2 {
    font-size: var(--text-xl);
    line-height: var(--leading-xl);
  }

  .badge {
    display: inline-flex;
    align-items: center;
    height: var(--control-xs);
    padding-inline: var(--space-sm);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-full);
    background: var(--muted);
    font-size: var(--text-xs);
    font-weight: var(--weight-medium);
  }

  .facts {
    display: grid;
    gap: var(--space-xs);
    margin: 0;
    padding-left: var(--space-xl);
    font-size: var(--text-sm);
  }

  .release {
    display: grid;
    gap: var(--space-md);
    justify-items: start;
    min-width: 0;
  }

  .release > :global(.code-block) {
    width: 100%;
  }

  .details {
    display: grid;
    gap: var(--space-xs);
    width: 100%;
    margin: 0;
    font-size: var(--text-sm);
  }

  .details div {
    display: grid;
    grid-template-columns: 80px minmax(0, 1fr);
    gap: var(--space-md);
    padding-block: var(--space-xs);
    border-bottom: var(--border-width) solid var(--border);
  }

  dt {
    color: var(--muted-foreground);
  }

  dd {
    margin: 0;
    min-width: 0;
  }

  .hash {
    overflow-wrap: anywhere;
  }

  .notice {
    padding: var(--space-md) var(--space-lg);
    border: var(--border-width) solid var(--border);
    border-left: 3px solid var(--info);
    border-radius: var(--radius-md);
    background: var(--muted);
    font-size: var(--text-sm);
  }

  .small {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  code {
    padding: 1px 4px;
    border-radius: var(--radius-sm);
    background: var(--muted);
  }

  .table-wrap {
    overflow-x: auto;
    width: 100%;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-sm);
  }

  caption {
    padding-bottom: var(--space-xs);
    font-weight: var(--weight-medium);
    text-align: left;
  }

  th,
  td {
    padding: var(--space-xs) var(--space-sm);
    border-bottom: var(--border-width) solid var(--border);
    text-align: left;
    white-space: nowrap;
  }

  th {
    color: var(--muted-foreground);
    font-weight: var(--weight-medium);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }
</style>
