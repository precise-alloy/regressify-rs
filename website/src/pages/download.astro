---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import CodeBlock from '../components/CodeBlock.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { downloadHref, formatSize, getRelease, getReleaseArchives } from '../lib/release';

// Facts on this page come from docs/desktop.md (Windows Installation and Updates,
// Build and Launch) and README.md. Only Windows x64 has an installer; release
// deployments also publish CLI and desktop archives for every built platform.
const release = await getRelease();
const latestHref = downloadHref(release);
const archives = await getReleaseArchives();
const platforms = [
  { id: 'windows', title: 'Windows', subtitle: 'x64 · Desktop & CLI', items: archives.filter((archive) => archive.target.endsWith('-msvc')) },
  { id: 'macos', title: 'macOS', subtitle: 'Apple silicon & Intel', items: archives.filter((archive) => archive.target.endsWith('-darwin')) },
  { id: 'linux', title: 'Linux', subtitle: 'x64 · glibc', items: archives.filter((archive) => archive.target.includes('-linux-')) },
];
const repoUrl = SITE.repoUrl;
const cloneUrl = repoUrl ? `${repoUrl}.git` : null;

const verify = release.status === 'available' ? `Get-FileHash .\\${release.fileName} -Algorithm SHA256` : '';
const windowsCliInstall = 'irm https://regressify.eshn.dev/install.ps1 | iex';
const unixCliInstall = 'curl -fsSL https://regressify.eshn.dev/install.sh | sh';

const fromSource = [
  cloneUrl ? `git clone ${cloneUrl}\ncd regressify-rs` : '# From a checkout of the Regressify repository',
  'cargo install --path .',
  'regressify install',
].join('\n');

const desktopFromSource = `cargo build --release --features gui --bin regressify-desktop`;

// Shared utility lists for markup repeated in loops.
const summaryBase =
  'flex min-h-[44px] cursor-pointer items-center [list-style:none] gap-md text-(length:--text-sm) [&::-webkit-details-marker]:hidden';
const summaryIcon = 'ml-auto flex-none transition-[transform] group-open/disclosure:[transform:rotate(90deg)]';
const disclosure = 'group/disclosure min-w-0 scroll-mt-[calc(var(--header-height)+24px)] border-t border-t-border';
const disclosureContent = 'grid min-w-0 gap-[20px] pt-sm pb-[20px]';
const detailRow = 'grid grid-cols-[76px_minmax(0,1fr)] gap-lg border-b border-b-border py-[9px]';
const cell = 'border-b border-b-border px-md py-[10px] text-left whitespace-nowrap';
const headCell = `${cell} font-medium text-muted-foreground`;
const platformNavLink =
  'inline-flex min-h-[44px] items-center border-b-2 border-b-transparent py-[10px] text-(length:--text-sm) text-muted-foreground no-underline hover:border-b-foreground hover:text-foreground focus-visible:border-b-foreground focus-visible:text-foreground';
---

<BaseLayout title="Download" description="Download the Regressify desktop app and CLI for Windows, macOS, and Linux, or build them from source.">
  <div class="page-container pt-[48px] pb-lg max-[700px]:pt-xxl">
    <header class="flex flex-wrap items-start justify-between gap-[20px]">
      <div>
        <h1 class="text-4xl leading-[1.2] tracking-[0] max-[700px]:text-3xl">Download Regressify</h1>
        <p class="muted mt-md">Desktop app and CLI. Chromium managed automatically.</p>
      </div>
      {release.status === 'available' && <span class="pt-[9px] font-mono text-(length:--text-sm) text-muted-foreground">v{release.version}</span>}
    </header>

    <nav class="mt-[28px] flex gap-[28px] border-b border-b-border" aria-label="Download platforms">
      <a href="#windows" class={platformNavLink}>Windows</a>
      <a href="#macos" class={platformNavLink}>macOS</a>
      <a href="#linux" class={platformNavLink}>Linux</a>
    </nav>

    {release.status !== 'available' && (
      <p class="mt-xl border-l-[3px] border-l-info bg-muted px-[18px] py-[14px] text-(length:--text-sm)" role="status">
        {release.status === 'unpublished'
          ? 'A release has not been published yet.'
          : 'Release details could not be verified when this page was built.'}
        {' '}<a href="#source-heading">Build from source</a> or try again later.
      </p>
    )}

    {platforms.map(({ id, title, subtitle, items }) => (
      <section
        id={id}
        class="grid scroll-mt-[calc(var(--header-height)+24px)] grid-cols-[220px_minmax(0,1fr)] gap-[48px] border-b border-b-border py-[36px] max-[700px]:grid-cols-[minmax(0,1fr)] max-[700px]:gap-xl max-[700px]:py-[28px]"
        aria-labelledby={`${id}-heading`}>
        <div class="max-[700px]:flex max-[700px]:flex-wrap max-[700px]:items-start max-[700px]:justify-between max-[700px]:gap-lg max-[420px]:grid">
          <div>
            <h2 id={`${id}-heading`} class="text-2xl leading-[1.3]">{title}</h2>
            <p class="mt-[6px] text-(length:--text-sm) text-muted-foreground">{subtitle}</p>
          </div>
          <div class="mt-[20px] flex flex-wrap items-start gap-[10px] max-[700px]:mt-0">
            {id === 'windows' && release.status === 'available' && (
              <>
                <Button variant="primary" href={latestHref ?? release.url} rel="noopener">
                  <Icon name="download" /> Download installer
                </Button>
                <span class="basis-full text-(length:--text-xs) text-muted-foreground">{formatSize(release.size)} · Desktop &amp; CLI</span>
              </>
            )}
            {id !== 'windows' && items.filter((archive) => archive.application === 'desktop' && archive.format === 'zip')
              .sort((left, right) => Number(right.target.startsWith('aarch64')) - Number(left.target.startsWith('aarch64')))
              .map((archive) => (
              <Button href={archive.url} title={archive.fileName}>
                <Icon name="download" />
                {id === 'macos' ? (archive.target.startsWith('aarch64') ? 'Apple silicon' : 'Intel') : 'Download desktop'}
              </Button>
            ))}
          </div>
        </div>

        <div class="min-w-0">
          <CodeBlock
            wrap
            title={id === 'windows' ? 'PowerShell' : 'Terminal · Desktop & CLI'}
            code={id === 'windows' ? windowsCliInstall : unixCliInstall}
            lang={id === 'windows' ? 'powershell' : 'sh'}
          />
          <a class="mt-[10px] mb-lg inline-block text-(length:--text-xs) text-muted-foreground" href={id === 'windows' ? '/install.ps1' : '/install.sh'}>Review install script</a>

          {id === 'windows' && release.status === 'available' && (
            <details class={disclosure}>
              <summary class={`${summaryBase} py-md`}>Installer details &amp; verification <Icon name="arrow-right" size={14} class={summaryIcon} /></summary>
              <div class={disclosureContent}>
                <p class="muted text-sm">Installs the desktop app, CLI, and managed Chromium without administrator rights. Open a new terminal after setup.</p>
                <dl class="m-0 grid text-(length:--text-sm)">
                  <div class={detailRow}><dt class="text-muted-foreground">Version</dt><dd class="m-0 min-w-0">{release.version}</dd></div>
                  <div class={detailRow}><dt class="text-muted-foreground">File</dt><dd class="m-0 min-w-0"><code class="[overflow-wrap:anywhere]">{release.fileName}</code></dd></div>
                  <div class={detailRow}><dt class="text-muted-foreground">Location</dt><dd class="m-0 min-w-0"><code class="[overflow-wrap:anywhere]">%LOCALAPPDATA%\Programs\Regressify</code></dd></div>
                  <div class={detailRow}><dt class="text-muted-foreground">SHA-256</dt><dd class="m-0 min-w-0"><code class="[overflow-wrap:anywhere]">{release.sha256}</code></dd></div>
                </dl>
                <CodeBlock wrap title="Verify SHA-256" code={verify} lang="powershell" />
              </div>
            </details>
          )}

          <details id={id === 'windows' ? 'windows-archives' : undefined} class={disclosure}>
            <summary class={`${summaryBase} py-md`}>Archives &amp; checksums <span class="text-(length:--text-xs) text-muted-foreground">{items.length} files</span><Icon name="arrow-right" size={14} class={summaryIcon} /></summary>
            <div class={disclosureContent}>
              {id === 'linux' && <p class="muted text-sm">Desktop requires compatible GUI libraries. Musl and Linux ARM64 builds are not available.</p>}
              {items.length > 0 ? (
                <div class="w-full overflow-x-auto" tabindex="0" role="region" aria-label={`${title} archive downloads`}>
                  <table class="w-full border-collapse text-(length:--text-sm)">
                    <caption class="visually-hidden text-left font-medium">{title} release assets</caption>
                    <thead><tr><th scope="col" class={headCell}>Architecture</th><th scope="col" class={headCell}>App</th><th scope="col" class={headCell}>File</th><th scope="col" class={headCell}>Size</th><th scope="col" class={headCell}>SHA-256</th></tr></thead>
                    <tbody>
                      {items.map((archive) => (
                        <tr>
                          <td class={cell}>{archive.target.startsWith('aarch64') ? 'Apple silicon' : id === 'macos' ? 'Intel' : 'x64'}</td>
                          <td class={cell}>{archive.application === 'cli' ? 'CLI' : 'Desktop'}</td>
                          <td class={cell}><a href={archive.url} title={archive.fileName}>{archive.format.toUpperCase()}</a></td>
                          <td class={cell}>{formatSize(archive.size)}</td>
                          <td class={cell}><a href={`${archive.url}.sha256`} title={archive.sha256}>{archive.sha256.slice(0, 12)}…</a></td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              ) : <p class="muted text-sm">Archives are unavailable. Build from source below.</p>}
            </div>
          </details>
        </div>
      </section>
    ))}

    <p class="my-xl max-w-[80ch] text-xs leading-sm text-muted-foreground">Install scripts verify SHA-256. Unsigned apps may trigger Windows SmartScreen or macOS Gatekeeper warnings. Terminal commands execute the linked install scripts.</p>

    <details id="source-heading" class={disclosure}>
      <summary class={`${summaryBase} py-[20px]`}><h2 class="text-(length:--text-lg) leading-[1.3]">Build from source</h2><Icon name="arrow-right" size={18} class={summaryIcon} /></summary>
      <div class={`${disclosureContent} max-w-[760px]`}>
        <p class="muted text-sm">Requires stable Rust. Chromium is managed automatically; no Node or Playwright installation is needed.</p>
        <CodeBlock wrap title="CLI" code={fromSource} lang="sh" />
        <CodeBlock wrap title="Desktop" code={desktopFromSource} lang="sh" />
        <p class="muted text-sm">Windows desktop builds also need the Visual Studio C++ build tools and Windows SDK.</p>
        <div class="flex flex-wrap gap-xl">
          <a href="/docs/getting-started/" class="inline-flex items-center gap-sm text-(length:--text-sm)">Getting started <Icon name="arrow-right" size={14} /></a>
          {repoUrl && <a href={repoUrl} class="inline-flex items-center gap-sm text-(length:--text-sm)">Source on GitHub <Icon name="github" size={14} /></a>}
        </div>
      </div>
    </details>
  </div>
</BaseLayout>
