---
import BaseLayout from './BaseLayout.astro';
import { getDocs } from '../lib/content';
import ImageZoom from '../components/ImageZoom.astro';
import type { MarkdownHeading } from 'astro';

interface Props {
  title: string;
  description: string;
  /** Collection id of the current doc; omitted on the docs index. */
  currentId?: string;
  /** Headings of the current doc, rendered as an "On this page" list under its link. */
  headings?: MarkdownHeading[];
}

const { title, description, currentId, headings = [] } = Astro.props;
const docs = await getDocs();

// Group each h3 under the preceding h2. h3s before the first h2 are dropped:
// they have no section to belong to in the sidebar.
const sections: { heading: MarkdownHeading; children: MarkdownHeading[] }[] = [];
for (const heading of headings) {
  if (heading.depth === 2) sections.push({ heading, children: [] });
  else if (heading.depth === 3) sections.at(-1)?.children.push(heading);
}
---

<BaseLayout title={title} description={description}>
  <div class="container docs">
    <aside class="sidebar">
      <p class="eyebrow">Documentation</p>
      <nav aria-label="Documentation">
        <ul>
          <li>
            <a href="/docs/" aria-current={currentId === undefined ? 'page' : undefined}>Overview</a>
          </li>
          {
            docs.map((doc) => (
              <li>
                <a href={`/docs/${doc.id}/`} aria-current={doc.id === currentId ? 'page' : undefined}>
                  {doc.data.title}
                </a>
                {doc.id === currentId && sections.length > 0 && (
                  <ul class="toc" aria-label="On this page" data-toc>
                    {sections.map(({ heading, children }) => (
                      <li data-toc-section>
                        <a href={`#${heading.slug}`} data-toc-link>
                          {heading.text}
                        </a>
                        {children.length > 0 && (
                          <ul class="toc-sub">
                            {children.map((child) => (
                              <li>
                                <a href={`#${child.slug}`} data-toc-link>
                                  {child.text}
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))
          }
        </ul>
      </nav>
    </aside>
    <article class="content">
      <slot />
    </article>
  </div>
  <ImageZoom />
</BaseLayout>

<script>
  // Scroll spy for the "On this page" list. Progressive enhancement: without
  // JavaScript the list still shows every h2 link; subsections stay collapsed.
  const toc = document.querySelector<HTMLElement>('[data-toc]');
  if (toc) {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const targets = links
      .map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }))
      .filter((entry): entry is { link: HTMLAnchorElement; heading: HTMLElement } => entry.heading !== null);
    const sidebar = toc.closest<HTMLElement>('.sidebar');
    let active: HTMLAnchorElement | null = null;
    let queued = false;

    const update = () => {
      queued = false;
      // Matches the scroll-padding-top used for anchor jumps, so a clicked link
      // becomes active exactly when its heading lands under the sticky header.
      const offset = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      let current = targets[0]?.link ?? null;
      for (const { link, heading } of targets) {
        if (heading.getBoundingClientRect().top - offset <= 1) current = link;
        else break;
      }
      // At the very bottom the last short sections can never reach the top.
      if (window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2) {
        current = targets.at(-1)?.link ?? current;
      }
      if (current === active) return;
      active?.removeAttribute('aria-current');
      toc.querySelector('[data-toc-section].open')?.classList.remove('open');
      active = current;
      if (!active) return;
      active.setAttribute('aria-current', 'location');
      active.closest('[data-toc-section]')?.classList.add('open');
      // Keep the active item visible inside the scrollable sticky sidebar without
      // scrolling the page itself (scrollIntoView would move the window too).
      if (sidebar && sidebar.scrollHeight > sidebar.clientHeight) {
        const box = active.getBoundingClientRect();
        const frame = sidebar.getBoundingClientRect();
        if (box.top < frame.top) sidebar.scrollTop -= frame.top - box.top + 16;
        else if (box.bottom > frame.bottom) sidebar.scrollTop += box.bottom - frame.bottom + 16;
      }
    };

    const schedule = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule);
    update();
  }
</script>

<style>
  .docs {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-xl) var(--space-xxl);
  }

  .sidebar {
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
  }

  .sidebar .eyebrow {
    margin-bottom: var(--space-sm);
    padding-inline: var(--space-sm);
  }

  ul {
    display: grid;
    gap: var(--space-xxs);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sidebar a {
    display: flex;
    align-items: center;
    min-height: var(--control-md);
    padding-inline: var(--space-sm);
    border-radius: var(--radius-md);
    color: var(--secondary-foreground);
    text-decoration: none;
  }

  .sidebar a:hover {
    background: var(--button-ghost-hover);
  }

  /*
   * The active background is below 3:1 against the page and disappears in
   * forced-colors mode, so the current page also gets a 2px indicator like the
   * header tabs. Padding shrinks by the border width to keep the text in place.
   */
  .sidebar a[aria-current='page'] {
    padding-left: calc(var(--space-sm) - var(--tab-underline-width));
    border-left: var(--tab-underline-width) solid var(--tab-underline);
    background: var(--secondary-active);
    font-weight: var(--weight-medium);
  }

  @media (forced-colors: active) {
    .sidebar a[aria-current='page'] {
      border-left-color: Highlight;
    }
  }

  .content {
    min-width: 0;
  }

  .toc {
    margin: var(--space-xxs) 0 var(--space-sm) var(--space-sm);
    padding-left: var(--space-sm);
    border-left: var(--border-width) solid var(--border);
  }

  .toc a {
    min-height: var(--control-sm);
    padding-block: var(--space-xxs);
    color: var(--muted-foreground);
    line-height: var(--leading-sm);
  }

  .toc a:hover {
    color: var(--foreground);
  }

  /* Same 2px indicator as the current page, so the active section is visible in
     forced-colors mode too. */
  .toc a[aria-current='location'] {
    padding-left: calc(var(--space-sm) - var(--tab-underline-width));
    border-left: var(--tab-underline-width) solid var(--tab-underline);
    color: var(--foreground);
    font-weight: var(--weight-medium);
  }

  .toc-sub {
    display: none;
    margin-left: var(--space-sm);
  }

  .toc-sub a {
    font-size: var(--text-xs);
  }

  .toc li.open > .toc-sub {
    display: grid;
  }

  @media (forced-colors: active) {
    .toc a[aria-current='location'] {
      border-left-color: Highlight;
    }
  }

  @media (min-width: 860px) {
    .docs {
      grid-template-columns: 240px minmax(0, 1fr);
      gap: var(--space-xxl);
    }

    .sidebar {
      position: sticky;
      top: 72px;
      align-self: start;
      /* Long "On this page" lists scroll inside the sidebar instead of past the viewport. */
      max-height: calc(100vh - 72px - var(--space-lg));
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: var(--space-lg);
      border-right: var(--border-width) solid var(--border);
    }
  }
</style>
