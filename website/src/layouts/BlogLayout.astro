---
import BaseLayout from './BaseLayout.astro';
import { formatDate } from '../lib/content';
import ImageZoom from '../components/ImageZoom.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  updated?: Date;
  author?: string;
}

const { title, description, date, updated, author } = Astro.props;
---

<BaseLayout title={title} description={description} type="article">
  <article class="page-container max-w-[calc(72ch+2*var(--space-xl))] py-xxl">
    <header class="mb-xl grid gap-sm">
      <a href="/blog/" class="text-(length:--text-sm) text-muted-foreground">Blog</a>
      <h1 class="text-3xl leading-[1.2]">{title}</h1>
      <p class="text-(length:--text-sm) text-muted-foreground">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {author && <span> · {author}</span>}
        {
          updated && (
            <span>
              {' '}
              · Updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time>
            </span>
          )
        }
      </p>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
  <ImageZoom />
</BaseLayout>
