---
// System / Light / Dark picker, matching the desktop theme menu. Hidden without
// JavaScript (the page then follows prefers-color-scheme). The initial theme is
// applied before first paint by ThemeScript.astro, on landing and docs pages.
import Icon from './Icon.astro';
import { THEME_STORAGE_KEY } from '../config/site';

const choices = [
  { value: 'system', label: 'Use system theme', icon: 'monitor' },
  { value: 'light', label: 'Use light theme', icon: 'sun' },
  { value: 'dark', label: 'Use dark theme', icon: 'moon' },
] as const;
---

<div class="theme-toggle requires-js" role="group" aria-label="Color theme" data-storage-key={THEME_STORAGE_KEY}>
  {
    choices.map((choice) => (
      <button type="button" class="choice" data-theme-choice={choice.value} aria-pressed="false" title={choice.label}>
        <Icon name={choice.icon} size={14} />
        <span class="visually-hidden">{choice.label}</span>
      </button>
    ))
  }
</div>

<script>
  type Choice = 'system' | 'light' | 'dark';

  // Several toggles can share a page (docs header and docs mobile menu), so the
  // pressed state is computed for every group from storage, not from the clicked
  // group. data-theme is always resolved (see ThemeScript.astro), so it cannot
  // tell "system" apart from an explicit choice.
  const groups = [...document.querySelectorAll<HTMLElement>('.theme-toggle')];
  const key = groups[0]?.dataset.storageKey ?? 'regressify-theme';
  const prefersLight = matchMedia('(prefers-color-scheme: light)');

  const saved = (): Choice => {
    try {
      const value = localStorage.getItem(key);
      return value === 'light' || value === 'dark' ? value : 'system';
    } catch {
      return 'system';
    }
  };

  let choice: Choice = saved();

  const sync = () => {
    for (const button of document.querySelectorAll<HTMLButtonElement>('.theme-toggle [data-theme-choice]')) {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === choice));
    }
  };

  const select = (next: Choice) => {
    choice = next;
    document.documentElement.dataset.theme = next === 'system' ? (prefersLight.matches ? 'light' : 'dark') : next;
    try {
      if (next === 'system') localStorage.removeItem(key);
      else localStorage.setItem(key, next);
    } catch {
      // Storage can be unavailable (privacy mode); the choice lasts for this page.
    }
    sync();
  };

  for (const group of groups) {
    for (const button of group.querySelectorAll<HTMLButtonElement>('[data-theme-choice]')) {
      button.addEventListener('click', () => select(button.dataset.themeChoice as Choice));
    }
  }

  // Another tab changed the preference; ThemeScript re-applies data-theme.
  window.addEventListener('storage', (event) => {
    if (event.key === key || event.key === null) {
      choice = saved();
      sync();
    }
  });

  sync();
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    gap: var(--space-xxs);
    padding: var(--space-xxs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--background);
  }

  .choice {
    display: inline-grid;
    place-items: center;
    width: var(--control-sm);
    height: var(--control-sm);
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--muted-foreground);
    cursor: pointer;
  }

  .choice:hover {
    background: var(--button-ghost-hover);
    color: var(--foreground);
  }

  /*
   * The selected background alone is about 1.3:1 against the toggle, below the
   * WCAG 1.4.11 3:1 minimum, and forced-colors mode drops it. The inset outline
   * keeps the state visible in both cases.
   */
  .choice[aria-pressed='true'] {
    background: var(--secondary);
    color: var(--secondary-foreground);
    outline: var(--border-width) solid var(--focus-indicator);
    outline-offset: calc(-1 * var(--border-width));
  }

  @media (forced-colors: active) {
    .choice[aria-pressed='true'] {
      outline: 2px solid Highlight;
      outline-offset: -2px;
    }
  }
</style>
