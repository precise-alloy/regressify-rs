---
// Logo and wordmark linking home. Shared by the site header and the docs header
// so both carry the same identity.
import { SITE } from '../config/site';
---

<a
  href="/"
  class="inline-flex min-h-[44px] shrink-0 items-center gap-sm whitespace-nowrap rounded-md text-(length:--text-sm) font-semibold text-foreground no-underline"
  aria-label={`${SITE.name} home`}>
  <img src="/icon.svg" alt="" width="22" height="22" class="block" />
  <span>{SITE.name}</span>
</a>
