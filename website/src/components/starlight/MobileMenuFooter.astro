---
// Starlight override: the bottom of the mobile sidebar menu (below 50rem). The
// docs header hides the site navigation, GitHub link, and theme toggle at that
// width, so they live here instead of in a second hamburger menu.
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { HEADER_LINKS, SITE } from '../../config/site';
import { isActivePath } from '../../lib/nav';
---

<div class="grid gap-sm border-t border-t-border pt-sm pb-lg">
  <nav aria-label="Site" class="grid">
    {
      HEADER_LINKS.map((link) => (
        <a
          href={link.href}
          class="flex min-h-[44px] items-center rounded-md px-sm text-(length:--text-sm) text-tab-foreground no-underline hover:bg-button-ghost-hover hover:text-tab-active-foreground aria-[current=page]:font-medium aria-[current=page]:text-tab-active-foreground"
          aria-current={isActivePath(Astro.url.pathname, link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </nav>
  <div class="flex items-center justify-between gap-md px-sm">
    {
      SITE.repoUrl && (
        <Button variant="ghost" size="md" icon href={SITE.repoUrl} aria-label="Regressify source on GitHub" title="Source on GitHub">
          <Icon name="github" />
        </Button>
      )
    }
    <ThemeToggle />
  </div>
</div>
