---
// Starlight override: the docs header in the Astro docs layout (identity left,
// search aligned with the content column, links and controls right) carrying the
// site header's identity: brand, main navigation, GitHub, and the theme toggle.
//
// Below 50rem (Starlight's sidebar breakpoint) only the brand and the search
// button remain; the navigation, GitHub, and theme toggle move into the sidebar
// menu (MobileMenuFooter.astro), opened by Starlight's own menu button, so the
// docs never show two hamburgers.
//
// The site links are labelled "Site" (here and in MobileMenuFooter) because
// Starlight's docs sidebar nav is already the "Main" navigation landmark.
import Search from '@astrojs/starlight/components/Search.astro';
import Brand from '../Brand.astro';
import Button from '../Button.astro';
import Icon from '../Icon.astro';
import ThemeToggle from '../ThemeToggle.astro';
import { HEADER_LINKS, SITE } from '../../config/site';
import { isActivePath } from '../../lib/nav';

// Same underline tabs as the site header (Header.astro).
const tabClass =
  'inline-flex items-center whitespace-nowrap border-b-(length:--tab-underline-width) border-b-transparent text-(length:--text-sm) text-tab-foreground no-underline hover:text-tab-active-foreground aria-[current=page]:border-b-tab-underline aria-[current=page]:text-tab-active-foreground';
---

{/* The `sl-header` layout (Starlight's header grid) lives in starlight.css. */}
<div class="sl-header">
  {/* The padding and negative margin leave room for the brand link's focus ring, which overflow would clip. */}
  <div class="-m-xs flex min-w-0 overflow-clip p-xs">
    <Brand />
  </div>
  <div class="flex justify-center print:hidden min-[50rem]:justify-start">
    <Search />
  </div>
  <div class="sl-hidden md:sl-flex items-stretch gap-xl self-stretch print:hidden">
    <nav aria-label="Site" class="flex gap-lg">
      {
        HEADER_LINKS.map((link) => (
          <a href={link.href} class={tabClass} aria-current={isActivePath(Astro.url.pathname, link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="flex items-center gap-sm before:h-control-sm before:me-xs before:border-s before:border-s-border">
      {
        SITE.repoUrl && (
          <Button variant="ghost" size="sm" icon href={SITE.repoUrl} aria-label="Regressify source on GitHub" title="Source on GitHub">
            <Icon name="github" />
          </Button>
        )
      }
      <ThemeToggle />
    </div>
  </div>
</div>
