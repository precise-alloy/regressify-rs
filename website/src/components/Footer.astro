---
import { FOOTER_LINKS, SITE } from '../config/site';

const linkClass = 'text-muted-foreground no-underline hover:text-foreground hover:underline';
---

<footer class="mt-xxl border-t border-t-border bg-status-bar text-sm">
  <div class="page-container flex flex-wrap items-center justify-between gap-lg py-xl">
    <div class="flex flex-wrap items-center gap-sm font-semibold">
      <img src="/icon.svg" alt="" width="18" height="18" />
      <span>{SITE.name}</span>
      <span class="muted font-normal">Visual regression testing for web pages.</span>
    </div>
    <nav aria-label="Footer">
      <ul class="m-0 flex list-none flex-wrap gap-x-lg gap-y-xs p-0">
        {
          FOOTER_LINKS.map((link) => (
            <li>
              <a href={link.href} class={linkClass}>{link.label}</a>
            </li>
          ))
        }
        {
          SITE.repoUrl && (
            <li>
              <a href={SITE.repoUrl} class={linkClass}>GitHub</a>
            </li>
          )
        }
        <li><a href="/rss.xml" class={linkClass}>RSS</a></li>
      </ul>
    </nav>
  </div>
</footer>
