---
// Monochrome code block, consistent with the desktop's neutral palette. `code`
// is rendered as escaped text. The copy button is a progressive enhancement.
import Icon from './Icon.astro';

interface Props {
  code: string;
  /** Optional caption shown in the title strip, e.g. a shell or file name. */
  title?: string;
  lang?: string;
  /** Wrap long lines instead of scrolling, for one-line install commands. */
  wrap?: boolean;
}

const { code, title, lang, wrap = false } = Astro.props;
---

{/* `code-block` is the hook for the shared pre styles in global.css and for the copy script. */}
<figure class="code-block m-0 min-w-0">
  {
    title && (
      <figcaption class="flex h-control-md items-center gap-sm rounded-t-lg border-x border-t border-x-border border-t-border bg-title-bar px-md text-(length:--text-xs) text-muted-foreground">
        <span>{title}</span>
      </figcaption>
    )
  }
  <div class="relative">
    {/* Right padding leaves room for the copy button so it never covers the first line. */}
    <pre
      data-lang={lang}
      class:list={[
        'pr-[calc(var(--control-sm)+var(--space-lg))]',
        title && 'rounded-t-none',
        wrap && 'whitespace-pre-wrap [overflow-wrap:anywhere]',
      ]}><code>{code}</code></pre>
    {/* Desktop focus_style also recolors the control's own border to the ring. */}
    <button
      type="button"
      class="group/copy requires-js absolute top-sm right-sm inline-grid size-control-sm cursor-pointer place-items-center rounded-md border border-input bg-button p-0 text-muted-foreground hover:bg-button-hover hover:text-foreground focus-visible:border-ring"
      data-copy
      aria-label="Copy code to clipboard"
      title="Copy">
      <Icon name="copy" size={14} class="group-data-copied/copy:hidden" />
      <Icon name="check" size={14} class="hidden group-data-copied/copy:block group-data-copied/copy:text-success" />
    </button>
    <!-- Focused buttons rarely announce aria-label changes, so results go through a live region. -->
    <span class="visually-hidden" aria-live="polite" data-copy-status></span>
  </div>
</figure>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('.code-block [data-copy]')) {
    button.addEventListener('click', async () => {
      const code = button.parentElement?.querySelector('code')?.textContent ?? '';
      const status = button.parentElement?.querySelector<HTMLElement>('[data-copy-status]');
      const announce = (message: string) => {
        if (!status) return;
        status.textContent = message;
        setTimeout(() => {
          if (status.textContent === message) status.textContent = '';
        }, 1500);
      };
      try {
        await navigator.clipboard.writeText(code);
        button.dataset.copied = 'true';
        announce('Copied to clipboard');
        setTimeout(() => delete button.dataset.copied, 1500);
      } catch {
        // Clipboard access can be denied; the code remains selectable.
        announce('Copy failed. Select the code to copy it manually.');
      }
    });
  }
</script>
