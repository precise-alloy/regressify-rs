---
// Mirrors gpui-component button.rs variants: default (outlined), primary
// (inverted), and ghost. Renders a link when `href` is set, otherwise a button.
import type { HTMLAttributes } from 'astro/types';

type Variant = 'default' | 'primary' | 'ghost';
type Size = 'sm' | 'md' | 'lg';

type Props = {
  variant?: Variant;
  size?: Size;
  href?: string;
  /** Square icon-only button; requires an accessible `aria-label`. */
  icon?: boolean;
  class?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const { variant = 'default', size = 'md', href, icon = false, class: className, ...rest } = Astro.props;

// gpui-component buttons draw labels at the theme's normal weight.
const base =
  'inline-flex items-center justify-center rounded-md border font-inherit font-normal leading-[1.25] whitespace-nowrap no-underline cursor-pointer transition-[background-color,border-color]';
// Heights follow the desktop control sizes; icon buttons are square with no inline padding.
const sizes: Record<Size, string> = {
  sm: 'h-control-sm gap-xs text-sm',
  md: 'h-control-md gap-sm text-sm',
  lg: 'h-control-lg gap-sm text-md',
};
const padding: Record<Size, string> = { sm: 'px-sm', md: 'px-[10px]', lg: 'px-lg' };
const iconWidth: Record<Size, string> = { sm: 'w-control-sm px-0', md: 'w-control-md px-0', lg: 'w-control-lg px-0' };
const variants: Record<Variant, string> = {
  // Desktop focus_style also recolors the control's own border to the ring.
  default:
    'border-input bg-button text-button-foreground hover:bg-button-hover hover:text-button-foreground active:bg-button-active focus-visible:border-ring',
  primary:
    'border-primary bg-primary text-primary-foreground hover:border-primary-hover hover:bg-primary-hover hover:text-primary-foreground active:bg-primary-active',
  // Desktop ghost buttons use button_active when pressed and the selected color when toggled on.
  ghost:
    'border-transparent bg-transparent text-button-ghost-foreground hover:bg-button-ghost-hover hover:text-button-ghost-foreground active:bg-button-active aria-pressed:bg-button-ghost-selected aria-[current=page]:bg-button-ghost-selected',
};
const classes = [base, sizes[size], icon ? iconWidth[size] : padding[size], variants[variant], className];
---

{
  href ? (
    <a href={href} class:list={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type="button" class:list={classes} {...rest}>
      <slot />
    </button>
  )
}
