---
// Echoes the desktop title bar: logo, semibold wordmark, underline tabs with a
// 2px active indicator, and ghost icon buttons on the right.
import Brand from './Brand.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { HEADER_LINKS, SITE } from '../config/site';
import { isActivePath } from '../lib/nav';

const isActive = (href: string) => isActivePath(Astro.url.pathname, href);

// Underline tabs with the desktop's 2px active indicator.
const tabClass =
  'inline-flex min-h-[36px] shrink-0 items-center whitespace-nowrap border-b-(length:--tab-underline-width) border-b-transparent px-0 text-(length:--text-sm) text-tab-foreground no-underline hover:text-tab-active-foreground aria-[current=page]:border-b-tab-underline aria-[current=page]:text-tab-active-foreground';
const mobileLinkClass =
  'flex min-h-[44px] items-center rounded-sm px-md py-sm text-(length:--text-sm) text-inherit no-underline [overflow-wrap:anywhere] hover:bg-accent hover:text-accent-foreground aria-[current=page]:bg-accent aria-[current=page]:text-accent-foreground';
---

{/* The ::before is the desktop title bar's 2px brand gradient stripe. */}
<header class="sticky top-0 z-5 border-b border-b-title-bar-border bg-title-bar before:block before:h-[2px] before:bg-(image:--brand-gradient)">
  <div class="page-container flex h-[48px] flex-nowrap items-center gap-x-sm sm:gap-x-xl">
    <Brand />
    <nav aria-label="Main" class="hidden min-w-0 flex-1 gap-lg self-stretch overflow-x-auto sm:flex">
      {
        HEADER_LINKS.map((link) => (
          <a href={link.href} class={tabClass} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="ml-auto flex shrink-0 items-center gap-xs sm:gap-sm">
      {
        SITE.repoUrl && (
          <Button variant="ghost" size="sm" icon href={SITE.repoUrl} aria-label="Regressify source on GitHub" title="Source on GitHub">
            <Icon name="github" />
          </Button>
        )
      }
      <ThemeToggle />
      {/* `mobile-nav` is the script hook. */}
      <details class="mobile-nav group/menu relative flex-[0_0_32px] sm:hidden">
        <summary
          aria-label="Navigation menu"
          title="Navigation menu"
          class="grid size-control-md cursor-pointer place-items-center [list-style:none] rounded-md text-button-ghost-foreground hover:bg-button-ghost-hover [&::-webkit-details-marker]:hidden">
          <Icon name="menu" class="group-open/menu:hidden" size={18} />
          <Icon name="x" class="hidden group-open/menu:block" size={18} />
        </summary>
        <nav
          aria-label="Main"
          class="absolute top-[calc(100%+8px)] right-0 max-h-[calc(100dvh-var(--header-height)-16px)] w-[min(20rem,calc(100vw-32px))] overflow-y-auto rounded-md border border-border bg-popover p-xs text-popover-foreground [box-shadow:var(--shadow-md)]">
          {
            HEADER_LINKS.map((link) => (
              <a href={link.href} class={mobileLinkClass} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-nav')) {
    const summary = menu.querySelector('summary')!;
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
        event.preventDefault();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
    matchMedia('(min-width: 640px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>
