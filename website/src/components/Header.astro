---
// Echoes the desktop title bar: logo, semibold wordmark, underline tabs with a
// 2px active indicator, and ghost icon buttons on the right.
import Brand from './Brand.astro';
import Button from './Button.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import { HEADER_LINKS, SITE } from '../config/site';
import { isActivePath } from '../lib/nav';

const isActive = (href: string) => isActivePath(Astro.url.pathname, href);
---

<header class="site-header">
  <div class="container bar">
    <Brand />
    <nav aria-label="Main" class="tabs">
      {
        HEADER_LINKS.map((link) => (
          <a href={link.href} class="tab" aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <div class="actions">
      {
        SITE.repoUrl && (
          <Button variant="ghost" size="sm" icon href={SITE.repoUrl} aria-label="Regressify source on GitHub" title="Source on GitHub">
            <Icon name="github" />
          </Button>
        )
      }
      <ThemeToggle />
      <details class="mobile-nav">
        <summary aria-label="Navigation menu" title="Navigation menu">
          <Icon name="menu" class="menu-open" size={18} />
          <Icon name="x" class="menu-close" size={18} />
        </summary>
        <nav aria-label="Main" class="mobile-links">
          {
            HEADER_LINKS.map((link) => (
              <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            ))
          }
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('.mobile-nav')) {
    const summary = menu.querySelector('summary')!;
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
        event.preventDefault();
      }
    });
    document.addEventListener('click', (event) => {
      if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
    });
    menu.addEventListener('focusout', (event) => {
      if (event.relatedTarget instanceof Node && !menu.contains(event.relatedTarget)) menu.open = false;
    });
    menu.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('a')) menu.open = false;
    });
    matchMedia('(min-width: 640px)').addEventListener('change', (event) => {
      if (event.matches) menu.open = false;
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--title-bar);
    border-bottom: var(--border-width) solid var(--title-bar-border);
  }

  .site-header::before {
    content: '';
    display: block;
    height: 2px;
    background: var(--brand-gradient);
  }

  .bar {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    column-gap: var(--space-sm);
    height: 48px;
  }

  .tabs {
    display: none;
    align-self: stretch;
    gap: var(--space-lg);
    flex: 1;
    min-width: 0;
    overflow-x: auto;
  }

  .tab {
    display: inline-flex;
    align-items: center;
    padding-inline: 0;
    min-height: 36px;
    color: var(--tab-foreground);
    font-size: var(--text-sm);
    text-decoration: none;
    border-bottom: var(--tab-underline-width) solid transparent;
    flex-shrink: 0;
    white-space: nowrap;
  }

  .tab:hover {
    color: var(--tab-active-foreground);
  }

  .tab[aria-current='page'] {
    color: var(--tab-active-foreground);
    border-bottom-color: var(--tab-underline);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-left: auto;
    flex-shrink: 0;
  }

  .mobile-nav {
    position: relative;
    flex: 0 0 32px;
  }

  .mobile-nav summary {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    color: var(--button-ghost-foreground);
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav summary:hover {
    background: var(--button-ghost-hover);
  }

  .mobile-nav :global(.menu-close),
  .mobile-nav[open] :global(.menu-open) {
    display: none;
  }

  .mobile-nav[open] :global(.menu-close) {
    display: block;
  }

  .mobile-links {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    width: min(20rem, calc(100vw - 32px));
    max-height: calc(100dvh - var(--header-height) - 16px);
    overflow-y: auto;
    padding: var(--space-xs);
    border: var(--border-width) solid var(--border);
    border-radius: var(--radius-md);
    background: var(--popover);
    color: var(--popover-foreground);
    box-shadow: var(--shadow-md);
  }

  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-sm) var(--space-md);
    border-radius: var(--radius-sm);
    color: inherit;
    font-size: var(--text-sm);
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .mobile-links a:hover,
  .mobile-links a[aria-current='page'] {
    background: var(--accent);
    color: var(--accent-foreground);
  }

  @media (min-width: 640px) {
    .bar {
      column-gap: var(--space-xl);
    }

    .tabs {
      display: flex;
    }

    .actions {
      gap: var(--space-sm);
    }

    .mobile-nav {
      display: none;
    }
  }
</style>
