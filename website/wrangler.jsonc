{
  "$schema": "mcp-worker/node_modules/wrangler/config-schema.json",
  "name": "regressify",
  "main": "mcp-worker/src/index.ts",
  "tsconfig": "mcp-worker/tsconfig.json",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "minify": true,
  "upload_source_maps": false,
  "workers_dev": false,
  "preview_urls": false,
  "send_metrics": false,
  "observability": {
    "enabled": false
  },
  "routes": [
    {
      "pattern": "regressify.eshn.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist",
    "not_found_handling": "404-page",
    "run_worker_first": ["/mcp"]
  }
}
